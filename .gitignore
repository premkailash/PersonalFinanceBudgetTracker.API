##############################################################################
#  FinanceApp REST API  — .gitignore
#  Stack: .NET 8 · ASP.NET Core · EF Core · PostgreSQL · xUnit
##############################################################################


# ─────────────────────────────────────────────────────────────────────────────
#  .NET / MSBuild build outputs
# ─────────────────────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
out/
publish/

# MSBuild binary and source logs
*.binlog
*.log

# NuGet packages — never commit the packages folder, only the lock file
*.nupkg
*.snupkg
[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Restore timestamp marker
.packages/

# NuGet lock file (commit this if you use locked-mode restore)
# packages.lock.json


# ─────────────────────────────────────────────────────────────────────────────
#  Visual Studio / VS Code / JetBrains Rider
# ─────────────────────────────────────────────────────────────────────────────

## Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsp
*.vspx
*.sap
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-snippets
*.code-workspace

## JetBrains Rider / ReSharper
.idea/
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
*.ReSharper.user

## Test Coverage
*.coverage
*.coveragexml
**/TestResults/
coverage-reports/


# ─────────────────────────────────────────────────────────────────────────────
#  ASP.NET Core / Runtime
# ─────────────────────────────────────────────────────────────────────────────

# Published artefacts
/publish/

# Local runtime files
*.pfx
*.crt
*.cer
*.p12

# HTTPS development certificate  — never commit private keys
*.pem
localhost.crt
localhost.key

# ASP.NET Core Data Protection keys
DataProtection-Keys/

# Entity Framework Core migrations snapshot is committed; do NOT add here.
# However, migration bundles are build artefacts:
efbundle
efbundle.exe


# ─────────────────────────────────────────────────────────────────────────────
#  Sensitive configuration — NEVER commit these
# ─────────────────────────────────────────────────────────────────────────────

# Environment-specific overrides that contain real secrets
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.local.json
appsettings.*.local.json

# .env files used by docker-compose or local scripts
.env
.env.*
!.env.example

# Secrets Manager / User Secrets (local development only)
secrets.json
**/secrets.json


# ─────────────────────────────────────────────────────────────────────────────
#  Docker
# ─────────────────────────────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml


# ─────────────────────────────────────────────────────────────────────────────
#  Operating system artefacts
# ─────────────────────────────────────────────────────────────────────────────

## macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

## Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

## Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ─────────────────────────────────────────────────────────────────────────────
#  Test artefacts
# ─────────────────────────────────────────────────────────────────────────────
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.xml.bak
mocha.opts
coverage/
lcov.info
*.lcov


# ─────────────────────────────────────────────────────────────────────────────
#  Logs and temporary files
# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
*.tmp
*.temp
*.swp
*.bak
*.orig
*.rej


# ─────────────────────────────────────────────────────────────────────────────
#  AWS / Azure / GCP deployment artefacts (if used)
# ─────────────────────────────────────────────────────────────────────────────
.aws/
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example


# ─────────────────────────────────────────────────────────────────────────────
#  Explicitly keep
# ─────────────────────────────────────────────────────────────────────────────
!appsettings.json
!.env.example
# EF Core migrations are source code — always commit them
!**/Migrations/
